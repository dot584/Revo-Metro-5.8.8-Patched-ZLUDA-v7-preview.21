+    pub fn link_ptx_member(&self, other: Module) -> Result<(), String> {
+        // LLVM's default handler can terminate the host process on a link error.
+        extern "C" fn record_diagnostic(
+            diagnostic: LLVMDiagnosticInfoRef,
+            context: *mut std::ffi::c_void,
+        ) {
+            unsafe {
+                let message = LLVMGetDiagInfoDescription(diagnostic);
+                let output = &mut *context.cast::<String>();
+                output.push_str(&CStr::from_ptr(message).to_string_lossy());
+                output.push('\n');
+                LLVMDisposeMessage(message);
+            }
+        }
+
+        let context = unsafe { LLVMGetModuleContext(self.get()) };
+        let handler = unsafe { LLVMContextGetDiagnosticHandler(context) };
+        let handler_context = unsafe { LLVMContextGetDiagnosticContext(context) };
+        let mut diagnostic = String::new();
+        unsafe {
+            LLVMContextSetDiagnosticHandler(
+                context,
+                Some(record_diagnostic),
+                std::ptr::from_mut(&mut diagnostic).cast(),
+            );
+        }
+        let result = self.link(other);
+        unsafe { LLVMContextSetDiagnosticHandler(context, handler, handler_context) };
+        result.map_err(|error| {
+            if diagnostic.is_empty() {
+                error.into()
+            } else {
+                diagnostic
+            }
+        })
+    }
+
     fn into_raw(self) -> LLVMModuleRef {
         let ptr = self.0;
         mem::forget(self);
