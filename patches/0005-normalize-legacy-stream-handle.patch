+const CU_STREAM_LEGACY_RAW: usize = 0x1;
+
+#[cfg(target_pointer_width = "64")]
+impl<'a, E: CudaErrorType> FromCuda<'a, CUstream, E> for hipStream_t {
+    fn from_cuda(x: &'a CUstream) -> Result<Self, E> {
+        if x.0 as usize == CU_STREAM_LEGACY_RAW {
+            Ok(hipStream_t(ptr::null_mut()))
+        } else {
+            Ok(unsafe { std::mem::transmute(*x) })
+        }
+    }
+}
+
+from_cuda_transmute_ptr!(CUstream => hipStream_t);
