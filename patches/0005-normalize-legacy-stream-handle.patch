+#[cfg(all(test, target_pointer_width = "64"))]
+mod stream_conversion_tests {
+    use super::*;
+
+    #[test]
+    fn maps_legacy_stream_to_null_hip_stream_and_preserves_other_handles() {
+        let null_stream = CUstream(ptr::null_mut());
+        let legacy_stream = CUstream(CU_STREAM_LEGACY_RAW as *mut CUstream_st);
+        let per_thread_stream = CUstream(0x2 as *mut CUstream_st);
+        let custom_stream = CUstream(0x1234_5678 as *mut CUstream_st);
+
+        let hip_null: hipStream_t = FromCuda::<_, CUerror>::from_cuda(&null_stream).unwrap();
+        let hip_legacy: hipStream_t = FromCuda::<_, CUerror>::from_cuda(&legacy_stream).unwrap();
+        let hip_per_thread: hipStream_t =
+            FromCuda::<_, CUerror>::from_cuda(&per_thread_stream).unwrap();
+        let hip_custom: hipStream_t = FromCuda::<_, CUerror>::from_cuda(&custom_stream).unwrap();
+
+        assert!(hip_null.0.is_null());
+        assert!(hip_legacy.0.is_null());
+        assert_eq!(hip_per_thread.0 as usize, 0x2);
+        assert_eq!(hip_custom.0 as usize, 0x1234_5678);
+    }
+}
